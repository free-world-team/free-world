# Unity text assets and all hash-governed provenance inputs must have identical
# bytes on Windows developer machines, CI runners, and release builders.
* text=auto eol=lf

# Preserve binary payloads byte-for-byte.
*.aiff binary
*.dll binary
*.exe binary
*.gif binary
*.jpeg binary
*.jpg binary
*.ogg binary
*.otf binary
*.pdf binary
*.png binary
*.psd binary
*.so binary
*.ttf binary
*.wav binary
*.zip binary
