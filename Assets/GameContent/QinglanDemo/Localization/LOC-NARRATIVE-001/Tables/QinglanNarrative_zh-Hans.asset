    m_Localized: "\u98CE\u8FC7\u6B8B\u7891\u65F6\uFF0C\u9646\u9752\u91CE\u542C\u89C1\u4E86\u4E00\u58F0\u5251\u9E23\u2014\u2014\u90A3\u91CC\u5206\u660E\u65E9\u5DF2\u65E0\u5251\u3002"
