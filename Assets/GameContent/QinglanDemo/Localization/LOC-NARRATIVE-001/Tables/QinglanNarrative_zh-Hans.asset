    m_Localized: "\u65E7\u5251\u7ADF\u8F7B\u6613\u51FA\u9798\u3002\u9798\u5185\u85CF\u7740\u4E00\u5F20\u7EB8\u6761\uFF1A\u7ED9\u98CE\u7559\u4E00\u6B65\u3002"
